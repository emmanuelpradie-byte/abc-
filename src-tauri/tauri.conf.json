{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mon Fournil",
  "version": "1.0.0",
  "identifier": "fr.maisonviennet.monfournil",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mon Fournil — Maison Viennet",
        "url": "https://emmanuelpradie-byte.github.io/abc-/",
        "width": 1400,
        "height": 900,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Maison Viennet",
    "shortDescription": "Recettes, production et catalogue — Maison Viennet",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
